{
  "name": "commander-static-completion",
  "version": "0.1.0",
  "description": "Generate standalone shell completions from Commander command definitions",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "test": "npm run build && node --test test/*.test.js",
    "check": "tsc --noEmit",
    "example": "npm run build --silent && node examples/generate.js",
    "prepack": "npm run build",
    "lint": "oxlint --deny-warnings src scripts test examples type-tests",
    "test:package": "tsx scripts/validate-package.ts",
    "validate": "npm run format:check && npm run lint && npm run check && npm test && npm run test:package",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "commander": "^15.0.0",
    "oxfmt": "0.67.0",
    "oxlint": "^1.82.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "commander": "^14.0.0 || ^15.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
