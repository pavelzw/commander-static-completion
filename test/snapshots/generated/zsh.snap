if [[ $ZSH_EVAL_CONTEXT == *:shfunc || $ZSH_EVAL_CONTEXT == *:loadautofunc ]]; then
  _csc_3c3e584a1e7b51e2 "$@"
else
  compdef _csc_3c3e584a1e7b51e2 'csc-test-cli'
fi
