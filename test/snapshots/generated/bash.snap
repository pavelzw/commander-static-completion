    for ((j=0; j<${#COMPREPLY[@]}; j++)); do
      COMPREPLY[j]=${COMPREPLY[j]#"$readline_prefix"}
    done
  fi
  if [[ $kind != file && $kind != directory && -n $COMP_LINE ]] && compopt -o noquote +o filenames 2>/dev/null; then
    # Quote static words ourselves: newer Readline can preserve expansion syntax
    # even with filename quoting enabled. Bash 3.2 uses registration-time quoting.
    for ((j=0; j<${#COMPREPLY[@]}; j++)); do
      candidate=${COMPREPLY[j]}
      if [[ $quote_char == "'" ]]; then
        candidate=${candidate//\'/\'\\\'\'}
        COMPREPLY[j]="$candidate'"
      elif [[ $quote_char == '"' ]]; then
        local k quoted=
        for ((k=0; k<${#candidate}; k++)); do
          char=${candidate:k:1}
          if [[ $char == '$' || $char == $'\x60' || $char == '"' || $char == \\ ]]; then quoted+='\'; fi
          quoted+=$char
        done
        COMPREPLY[j]=$quoted'"'
      else
        printf -v 'COMPREPLY[j]' '%q' "$candidate"
      fi
    done
  fi

  return 0
}

complete -o filenames -F _csc_5bf334227f4327fd -- 'csc-test-cli'
